#!/bin/sh
# コミット前に、ステージした内容（コミットに入る版）を検査する（docs/harness.md H6）。
# 公開リポジトリなので、一度 push した秘密は履歴から消しても回収できない。載る前に止める。
# --no-verify で外せるのは人だけ（AI には .claude/settings.json の deny で禁止している）。
set -e
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-sensitive.sh" --staged

# gofmt 漏れ（ステージした .go だけ）
go_files="$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')"
if [ -n "$go_files" ]; then
  unformatted="$(cd "$root" && echo "$go_files" | xargs gofmt -l)"
  if [ -n "$unformatted" ]; then
    echo "[pre-commit] gofmt されていないファイルがあります: $unformatted" >&2
    echo "  make fmt を実行してからステージし直してください。" >&2
    exit 1
  fi
fi
