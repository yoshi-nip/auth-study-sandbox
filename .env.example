# make setup がこのファイルを .env にコピーし、change-me をランダム値に置き換える。
# ここに本物の秘密を書かない（公開リポジトリ）。

# ホストに公開するポート（公開するのは nginx だけ）
HTTP_PORT=8080
HTTPS_PORT=8443
# L4（TCP）プロキシの練習用ポート。127.0.0.1 にだけ公開する（Phase 5）
L4_PORT=9000

# デモユーザー（alice: editor / bob: viewer）のパスワード。公開して困らないデモ用の値
DEMO_PASSWORD=sandbox-demo-pass

# BFF が認証基盤（自作 OIDC / Keycloak）に名乗るためのクライアントシークレット
BFF_CLIENT_SECRET=change-me
# 認証基盤のユーザー DB のパスワード
AUTH_DB_PASSWORD=change-me

# nginx のエッジ認証（auth_request）。/_auth で有効、off で無効（BFF と API の層だけで止める）
NGINX_AUTH_REQUEST=/_auth

# アクセストークンの有効期限と、BFF が期限の何秒前にリフレッシュするか
ACCESS_TOKEN_TTL=5m
REFRESH_SKEW=30s
# BFF セッションのアイドル期限と絶対期限
SESSION_IDLE_TTL=30m
SESSION_ABSOLUTE_TTL=8h
